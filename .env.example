DB_URL=jdbc:postgresql://localhost:5432/gamehub
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password

# Generate a unique secret containing at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=21600000

# Optional: set all four values to seed the first administrator.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAYNAME=

CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
